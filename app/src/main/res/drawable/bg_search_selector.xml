<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <!-- Focus state: Lighter glass with prominent gold border -->
            <solid android:color="#E61A1C21" />
            <corners android:radius="20dp" />
            <stroke android:width="2.5dp" android:color="@color/accent_gold" />
        </shape>
    </item>
    <item>
        <shape>
            <!-- Normal state: Classic dark glass -->
            <solid android:color="#CC0A0E14" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#26FFD700" />
        </shape>
    </item>
</selector>
