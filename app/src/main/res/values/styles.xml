<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SettingsSectionHeader" parent="ExclusiveText.Header">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_settings_header</item>
        <item name="android:textColor">@color/accent_gold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>

    <style name="SettingsCardContainer" parent="ExclusiveCard.Glass">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:layout_marginBottom">20dp</item>
    </style>

    <style name="SettingsToggleItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/ripple_effect</item>
        <item name="android:padding">@dimen/settings_item_padding</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SettingsActionItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/ripple_effect</item>
        <item name="android:padding">@dimen/settings_item_padding</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">@dimen/text_size_settings_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:drawableTint">@color/accent_gold</item>
    </style>

    <style name="PortfolioActionItem" parent="SettingsActionItem">
        <item name="android:textColor">@color/white</item>
        <item name="android:alpha">0.9</item>
    </style>

    <style name="SettingsIcon">
        <item name="android:layout_width">@dimen/settings_icon_size</item>
        <item name="android:layout_height">@dimen/settings_icon_size</item>
        <item name="android:tint">@color/accent_gold</item>
    </style>

    <style name="SettingsTextContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="SettingsTitle" parent="ExclusiveText.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_settings_title</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="SettingsSubtitle" parent="ExclusiveText.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_settings_subtitle</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="SettingsStatusText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_settings_subtitle</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsValueText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_settings_subtitle</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>
    
    <style name="SettingsChevron">
        <item name="android:layout_width">@dimen/settings_chevron_size</item>
        <item name="android:layout_height">@dimen/settings_chevron_size</item>
        <item name="android:src">@drawable/ic_arrow_right</item>
        <item name="android:tint">@color/text_secondary</item>
        <item name="android:alpha">0.5</item>
    </style>

    <!-- Exclusive Design System Text Styles -->
    <style name="ExclusiveText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ExclusiveText.Header">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_header</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="ExclusiveText.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="ExclusiveText.Accent" parent="ExclusiveText.Body">
        <item name="android:textColor">@color/accent_gold</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Glass Surface Styles -->
    <style name="ExclusiveCard">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ExclusiveCard.Glass">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_transparent_glass</item>
        <item name="android:elevation">@dimen/elevation_default</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#1AFFFFFF</item>
        <item name="android:layout_marginStart">@dimen/settings_divider_margin</item> 
    </style>

    <style name="SettingsPanelStyle" parent="ExclusiveCard.Glass">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">end</item>
    </style>

    <style name="ResponsiveDialogStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">24dp</item>
        <item name="android:layout_marginRight">24dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">24dp</item>
    </style>

    <style name="ResponsiveOverlayStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">24dp</item>
        <item name="android:layout_marginRight">24dp</item>
    </style>
    <style name="NumPadButton">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>
</resources>
