<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <!-- Semi-transparent overlay for the left side (optional, but helps focus) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- Main Content Container restricted to right half -->
    <LinearLayout
        android:id="@+id/container"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        style="@style/ExclusiveCard.Glass"
        android:background="@color/surface_glass">

        <!-- Modern Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_header_gradient"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_back_nav"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/logo_exclusive"
                    android:layout_marginEnd="16dp" 
                    android:contentDescription="App Logo"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/name"
                        style="@style/ExclusiveText.Header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/version"
                        style="@style/ExclusiveText.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Settings"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:alpha="0.7"/>
                </LinearLayout>
                
                <ImageView
                    android:id="@+id/close_menu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_close" 
                    android:background="@drawable/ripple_effect"
                    android:tint="@color/text_secondary"
                    app:tint="@color/text_secondary"
                    android:focusable="true"
                    tools:ignore="UseAppTint" />

            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/settings_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="32dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp">

                <!-- Section: Content -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="Connection &amp; Content" />

                <LinearLayout
                    style="@style/SettingsCardContainer"
                    android:background="@drawable/bg_settings_card">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp">
                        
                        <EditText
                            android:id="@+id/config"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:hint="Enter Playlist URL"
                            android:textColorHint="#66FFFFFF"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/tv_input_bg"
                            android:paddingHorizontal="18dp"
                            android:textSize="14sp"
                            android:inputType="textUri"
                            android:imeOptions="actionDone"
                            android:singleLine="true"/>

                        <Button
                            android:id="@+id/confirm_config"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="16dp"
                            android:drawableStart="@drawable/ic_check"
                            android:background="@drawable/tv_button_bg"
                            android:elevation="4dp"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="0dp"
                            tools:ignore="SpeakableTextPresentCheck" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider"/>

                    <TextView
                        android:id="@+id/manage_playlists"
                        style="@style/SettingsActionItem"
                        android:text="Manage Subscription Sources"
                        android:drawableStart="@drawable/ic_playlist" />

                    <View style="@style/SettingsDivider"/>

                    <TextView
                        android:id="@+id/manage_categories"
                        style="@style/SettingsActionItem"
                        android:text="Organize Categories"
                        android:drawableStart="@drawable/ic_category" />

                </LinearLayout>


                <!-- Section: Playback -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="Playback Engine"
                    android:layout_marginTop="28dp"/>

                <LinearLayout style="@style/SettingsCardContainer">

                    <LinearLayout
                        android:id="@+id/card_channel_reversal"
                        style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_category" />
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="@string/title_channel_reversal"/>
                            <TextView style="@style/SettingsSubtitle" android:text="Invert DPAD up/down behavior"/>
                        </LinearLayout>
                        <TextView android:id="@+id/status_channel_reversal" style="@style/SettingsStatusText" android:text="OFF"/>
                    </LinearLayout>
                    <View style="@style/SettingsDivider"/>

                    <LinearLayout
                        android:id="@+id/card_channel_num"
                        style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_info_outline"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Smart Channel IDs"/>
                            <TextView style="@style/SettingsSubtitle" android:text="Show index numbers in navigation list"/>
                        </LinearLayout>
                        <TextView android:id="@+id/status_channel_num" style="@style/SettingsStatusText" android:text="OFF"/>
                    </LinearLayout>
                    <View style="@style/SettingsDivider"/>

                    <LinearLayout
                        android:id="@+id/card_watch_last"
                        style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_update"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Auto-Resume last channel"/>
                            <TextView style="@style/SettingsSubtitle" android:text="Instantly play previous channel on start"/>
                        </LinearLayout>
                        <TextView android:id="@+id/status_watch_last" style="@style/SettingsStatusText" android:text="OFF"/>
                    </LinearLayout>
                    <View style="@style/SettingsDivider"/>

                    <LinearLayout
                        android:id="@+id/card_force_high_quality"
                        style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_video_quality"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="High Bitrate Priority"/>
                            <TextView style="@style/SettingsSubtitle" android:text="Always choose highest available resolution"/>
                        </LinearLayout>
                        <TextView android:id="@+id/status_force_high_quality" style="@style/SettingsStatusText" android:text="OFF"/>
                    </LinearLayout>
                    <View style="@style/SettingsDivider"/>

                    <LinearLayout
                        android:id="@+id/card_pip_mode"
                         style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_video_quality"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Picture-in-Picture Mode"/>
                             <TextView style="@style/SettingsSubtitle" android:text="Watch while using other apps"/>
                        </LinearLayout>
                         <TextView android:id="@+id/status_pip_mode" style="@style/SettingsStatusText" android:text="OFF"/>
                    </LinearLayout>
                    <View style="@style/SettingsDivider"/>

                    <LinearLayout
                        android:id="@+id/card_buffer_mode"
                         style="@style/SettingsToggleItem">
                         <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_buffer"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Dynamic Buffering"/>
                             <TextView android:id="@+id/status_buffer_mode" style="@style/SettingsValueText" android:text="Default"/>
                        </LinearLayout>
                        <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- Section: Audio -->
                 <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="Audio Performance"
                    android:layout_marginTop="28dp"/>
                
                 <LinearLayout style="@style/SettingsCardContainer">
                    <LinearLayout
                        android:id="@+id/card_audio_language"
                         style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_audio_track"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Preferred Audio Track"/>
                            <TextView style="@style/SettingsSubtitle" android:text="Select default language for streams"/>
                        </LinearLayout>
                        <TextView android:id="@+id/status_audio_language" style="@style/SettingsValueText" android:text="Default"/>
                         <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>
                    <View style="@style/SettingsDivider"/>

                    <LinearLayout
                        android:id="@+id/card_audio_stabilizer"
                         style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_audio_track"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Audio Normalizer"/>
                             <TextView style="@style/SettingsSubtitle" android:text="Balances volume across channels"/>
                        </LinearLayout>
                        <TextView android:id="@+id/status_audio_stabilizer" style="@style/SettingsStatusText" android:text="OFF"/>
                    </LinearLayout>
                 </LinearLayout>


                <!-- Section: Interface -->
                 <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="Visual Appearance"
                    android:layout_marginTop="28dp"/>

                 <LinearLayout style="@style/SettingsCardContainer">
                    <LinearLayout
                        android:id="@+id/card_time"
                         style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_time"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Digital Dashboard Clock"/>
                             <TextView style="@style/SettingsSubtitle" android:text="Display current time in top bar"/>
                        </LinearLayout>
                        <TextView android:id="@+id/status_time" style="@style/SettingsStatusText" android:text="OFF"/>
                    </LinearLayout>
                    <View style="@style/SettingsDivider"/>
                    
                     <LinearLayout
                        android:id="@+id/card_show_date_in_info"
                        style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_time"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Calendar Date Display"/>
                             <TextView style="@style/SettingsSubtitle" android:text="Show date in information panels"/>
                        </LinearLayout>
                         <TextView android:id="@+id/status_show_date_in_info" style="@style/SettingsStatusText" android:text="ON"/>
                    </LinearLayout>
                    <View style="@style/SettingsDivider"/>

                    <LinearLayout
                        android:id="@+id/card_watermark"
                        style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_watermark"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Exclusive Watermark"/>
                            <TextView style="@style/SettingsSubtitle" android:text="Show subtle branded logo"/>
                        </LinearLayout>
                        <TextView android:id="@+id/status_watermark" style="@style/SettingsStatusText" android:text="OFF"/>
                    </LinearLayout>
                 </LinearLayout>

                <!-- Section: System -->
                 <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="Internal System"
                    android:layout_marginTop="28dp"/>

                <LinearLayout style="@style/SettingsCardContainer">
                    
                    <LinearLayout
                         android:id="@+id/card_boot_startup"
                         style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_update"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Auto-launch at boot"/>
                        </LinearLayout>
                         <TextView android:id="@+id/status_boot_startup" style="@style/SettingsStatusText" android:text="OFF"/>
                    </LinearLayout>
                    <View style="@style/SettingsDivider"/>

                    <LinearLayout
                         android:id="@+id/card_config_auto_load"
                         style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_update"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Background Sync"/>
                             <TextView style="@style/SettingsSubtitle" android:text="Refresh resources on every start"/>
                        </LinearLayout>
                         <TextView android:id="@+id/status_config_auto_load" style="@style/SettingsStatusText" android:text="OFF"/>
                    </LinearLayout>
                    <View style="@style/SettingsDivider"/>

                    <LinearLayout
                         android:id="@+id/card_channel_check"
                         style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_trash"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Stream Validator"/>
                             <TextView style="@style/SettingsSubtitle" android:text="Automatically filter dead streams"/>
                        </LinearLayout>
                         <TextView android:id="@+id/status_channel_check" style="@style/SettingsStatusText" android:text="OFF"/>
                    </LinearLayout>
                    <View style="@style/SettingsDivider"/>

                    <LinearLayout
                         android:id="@+id/card_epg"
                         style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_epg"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Electronic Program Guide"/>
                             <TextView style="@style/SettingsSubtitle" android:text="Enable TV Guide integration"/>
                        </LinearLayout>
                         <TextView android:id="@+id/status_epg" style="@style/SettingsStatusText" android:text="OFF"/>
                    </LinearLayout>
                    <View style="@style/SettingsDivider"/>

                    <LinearLayout
                         android:id="@+id/card_epg_shift"
                         style="@style/SettingsToggleItem">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_time"/>
                        <LinearLayout style="@style/SettingsTextContainer">
                            <TextView style="@style/SettingsTitle" android:text="Time Zone Correction"/>
                            <TextView style="@style/SettingsSubtitle" android:text="Shift EPG time to match local clock"/>
                        </LinearLayout>
                         <TextView android:id="@+id/status_epg_shift" style="@style/SettingsValueText" android:text="0h"/>
                         <ImageView style="@style/SettingsChevron"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- Actions -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="Maintenance"
                    android:layout_marginTop="28dp"/>

                 <LinearLayout style="@style/SettingsCardContainer">
                     <TextView
                        android:id="@+id/check_version"
                        style="@style/SettingsActionItem"
                        android:text="System Integrity &amp; Updates"
                        android:drawableStart="@drawable/ic_update" />
                    
                     <View style="@style/SettingsDivider"/>
                    
                    <TextView
                        android:id="@+id/copyrightInfo"
                        style="@style/SettingsActionItem"
                        android:text="About &amp; Legal"
                        android:drawableStart="@drawable/ic_info_outline" />
                    
                    <View style="@style/SettingsDivider"/>

                    <TextView
                        android:id="@+id/app_website"
                        style="@style/SettingsActionItem"
                        android:text="Official App Website"
                        android:drawableStart="@drawable/ic_website" />
                    
                    <View style="@style/SettingsDivider"/>
                    <TextView
                        android:id="@+id/clear"
                        style="@style/SettingsActionItem"
                        android:text="Master Factory Reset"
                        android:drawableStart="@drawable/ic_trash"
                        android:textColor="@color/accent_red"/>
                 </LinearLayout>

                <!-- Developer Credit Section (Moved into Scrollable Content) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="32dp"
                    android:paddingBottom="40dp">

                    <View 
                        style="@style/SettingsDivider" 
                        android:layout_marginStart="0dp"
                        android:layout_marginBottom="24dp"
                        android:alpha="0.3"/>

                    <LinearLayout
                        android:id="@+id/portfolio_compact_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="@drawable/bg_settings_card"
                        android:elevation="2dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/logo_exclusive"
                            android:padding="6dp"
                            android:background="@drawable/tv_button_bg"
                            android:elevation="2dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CodesRahul"
                                android:textColor="@color/accent_gold"
                                android:textSize="16sp"
                                android:textStyle="bold"/>
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Android &amp; Backend Developer"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/portfolio_website"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:padding="8dp"
                                android:src="@drawable/ic_website"
                                android:background="@drawable/ripple_effect"
                                android:tint="@color/accent_gold"
                                android:focusable="true"
                                tools:ignore="UseAppTint" />

                            <ImageView
                                android:id="@+id/portfolio_linkedin"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="8dp"
                                android:padding="8dp"
                                android:src="@drawable/ic_linkedin"
                                android:background="@drawable/ripple_effect"
                                android:tint="@color/accent_gold"
                                android:focusable="true"
                                tools:ignore="UseAppTint" />

                            <ImageView
                                android:id="@+id/portfolio_github"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="8dp"
                                android:padding="8dp"
                                android:src="@drawable/ic_github"
                                android:background="@drawable/ripple_effect"
                                android:tint="@color/accent_gold"
                                android:focusable="true"
                                tools:ignore="UseAppTint" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Footer Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="20dp">
                        
                        <TextView
                            android:id="@+id/versionName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="v1.0.0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary" 
                            android:alpha="0.8"/>

                        <TextView
                            android:id="@+id/device_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IP: -- | MAC: --"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="6dp"
                            android:alpha="0.9"
                            android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
