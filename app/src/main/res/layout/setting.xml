<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#E60A0E14"
        android:orientation="vertical"
        android:padding="24dp"
        android:elevation="50dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/logo_exclusive"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Control Center &amp; Settings"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#80FFFFFF"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginBottom="24dp" />

        <ScrollView
            android:id="@+id/settings_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Content Management Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTENT MANAGEMENT"
                    android:textSize="12sp"
                    android:textColor="#00B0FF"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/config"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Config URL"
                        android:textColorHint="#4DFFFFFF"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/tv_input_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="14sp"
                        android:lines="1"
                        android:inputType="textUri" />

                    <Button
                        android:id="@+id/confirm_config"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Add Playlist Source"
                        android:background="@drawable/tv_button_bg"
                        android:textColor="#FFFFFF"
                        android:drawableStart="@drawable/ic_playlist"
                        android:drawablePadding="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="start|center_vertical"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/manage_playlists"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Manage Sources"
                        android:background="@drawable/tv_button_bg_secondary"
                        android:textColor="#FFFFFF"
                        android:drawableStart="@drawable/ic_playlist"
                        android:drawableTint="#80FFFFFF"
                        android:drawablePadding="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="start|center_vertical"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/manage_categories"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Manage Categories &amp; Order"
                        android:background="@drawable/tv_button_bg_secondary"
                        android:textColor="#FFFFFF"
                        android:drawableStart="@drawable/ic_category"
                        android:drawableTint="#80FFFFFF"
                        android:drawablePadding="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="start|center_vertical"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Preferences Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREFERENCES"
                    android:textSize="12sp"
                    android:textColor="#00B0FF"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Card: Channel Reversal -->
                <LinearLayout
                    android:id="@+id/card_channel_reversal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_category"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/title_channel_reversal"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_channel_reversal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Channel Numbers -->
                <LinearLayout
                    android:id="@+id/card_channel_num"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info_outline"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Show Channel Numbers"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_channel_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Display Time -->
                <LinearLayout
                    android:id="@+id/card_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_time"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Display Digital Clock"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Show Date in Info -->
                <LinearLayout
                    android:id="@+id/card_show_date_in_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_time"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Show Date in Info Card"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_show_date_in_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ON"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Watch Last -->
                <LinearLayout
                    android:id="@+id/card_watch_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_update"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Resume Last Channel"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_watch_last"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Force High Quality -->
                <LinearLayout
                    android:id="@+id/card_force_high_quality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_video_quality"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Force High Quality"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_force_high_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Audio Language -->
                <LinearLayout
                    android:id="@+id/card_audio_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_audio_track"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Default Audio Language"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_audio_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Buffer Mode -->
                <LinearLayout
                    android:id="@+id/card_buffer_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_buffer"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Buffer Mode (Stability)"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_buffer_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Audio Stabilizer -->
                <LinearLayout
                    android:id="@+id/card_audio_stabilizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_audio_track"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Audio Stabilizer (Boost Low Volume)"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_audio_stabilizer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Boot Startup -->
                <LinearLayout
                    android:id="@+id/card_boot_startup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_update"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Automatic Startup"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_boot_startup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Auto Load -->
                <LinearLayout
                    android:id="@+id/card_config_auto_load"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_update"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Auto-update on Startup"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_config_auto_load"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Channel Check -->
                <LinearLayout
                    android:id="@+id/card_channel_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_trash"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Prune Dead Channels"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_channel_check"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: EPG -->
                <LinearLayout
                    android:id="@+id/card_epg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_epg"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Enable EPG Logic"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_epg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
 
                 <!-- Card: EPG Shift -->
                 <LinearLayout
                     android:id="@+id/card_epg_shift"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:orientation="horizontal"
                     android:padding="16dp"
                     android:background="@drawable/bg_settings_card"
                     android:layout_marginBottom="8dp"
                     android:focusable="true"
                     android:gravity="center_vertical">
                     
                     <ImageView
                         android:layout_width="24dp"
                         android:layout_height="24dp"
                         android:src="@drawable/ic_time"
                         android:tint="#FFD700" />
                         
                     <TextView
                         android:layout_width="0dp"
                         android:layout_weight="1"
                         android:layout_height="wrap_content"
                         android:text="EPG Time Shift (Hours)"
                         android:textColor="#FFFFFF"
                         android:layout_marginStart="12dp"
                         android:textSize="14sp" />
                         
                     <TextView
                         android:id="@+id/status_epg_shift"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:text="0h"
                         android:textColor="#80FFFFFF"
                         android:textSize="12sp" />
                 </LinearLayout>

                <!-- Card: Watermark -->
                <LinearLayout
                    android:id="@+id/card_watermark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_watermark"
                        android:tint="#FFD700" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Show Watermark"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp"
                        android:textSize="14sp" />
                        
                    <TextView
                        android:id="@+id/status_watermark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Actions Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM ACTIONS"
                    android:textSize="12sp"
                    android:textColor="#00B0FF"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/clear"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Factory Reset"
                    android:background="@drawable/tv_button_bg"
                    android:textColor="#FFFFFF"
                    android:drawableStart="@drawable/ic_trash"
                    android:drawableTint="#80FFFFFF"
                    android:drawablePadding="12dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="start|center_vertical"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/check_version"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Check for Updates"
                    android:background="@drawable/tv_button_bg"
                    android:textColor="#FFFFFF"
                    android:drawableStart="@drawable/ic_update"
                    android:drawableTint="#80FFFFFF"
                    android:drawablePadding="12dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="start|center_vertical"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/copyright_info"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Copyright Info"
                    android:background="@drawable/tv_button_bg"
                    android:textColor="#FFFFFF"
                    android:drawableStart="@drawable/ic_info_outline"
                    android:drawableTint="#80FFFFFF"
                    android:drawablePadding="12dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="start|center_vertical"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/close_menu"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Close Drawer"
                    android:background="@drawable/tv_button_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>
        </ScrollView>
        


        <TextView
            android:id="@+id/versionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textSize="10sp"
            android:textColor="#4DFFFFFF"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/device_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP: -- | MAC: --"
            android:textSize="10sp"
            android:textColor="#4DFFFFFF"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/developer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developed by CodesRahul96"
