<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="64dp"
        android:background="@drawable/bg_search_selector"
        android:addStatesFromChildren="true"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/white" />

        <EditText
            android:id="@+id/search_edit_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:background="@null"
            android:hint="Search Channels by Name or Number..."
            android:textColorHint="#99FFFFFF"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:focusable="true"
            android:singleLine="true"
            android:nextFocusDown="@+id/history_chips_scroll">
            <requestFocus />
        </EditText>

        <ImageView
            android:id="@+id/btn_voice"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            android:background="@drawable/bg_icon_btn_selector"
            android:src="@android:drawable/ic_btn_speak_now"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusDown="@+id/history_chips_scroll"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btn_keypad"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            android:background="@drawable/bg_icon_btn_selector"
            android:src="@android:drawable/ic_dialog_dialer"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusDown="@+id/history_chips_scroll"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btn_clear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="@drawable/bg_icon_btn_selector"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusDown="@+id/history_chips_scroll"
            app:tint="@color/white" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/history_chips_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="64dp"
        android:scrollbars="none"
        android:focusable="true"
        android:nextFocusUp="@+id/search_edit_text"
        android:nextFocusDown="@+id/search_results"
        app:layout_constraintTop_toBottomOf="@id/search_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:id="@+id/history_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_results"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="64dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:nextFocusUp="@+id/history_chips_scroll"
        android:nextFocusDown="@+id/btn1"
        app:layout_constraintTop_toBottomOf="@id/history_chips_scroll"
        app:layout_constraintBottom_toTopOf="@id/num_pad_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/list_item" />

    <!-- [MOBILE] Professional T9 Numeric Keypad -->
    <FrameLayout
        android:id="@+id/num_pad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <GridLayout
            android:id="@+id/num_pad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_transparent_glass"
            android:padding="8dp"
            android:columnCount="3"
            android:rowCount="4">

            <!-- Professional T9 Keys: Number + Letters -->
            
            <Button android:id="@+id/btn1" style="@style/NumPadButton" android:text="1\n·" android:textAllCaps="false" />
            <Button android:id="@+id/btn2" style="@style/NumPadButton" android:text="2\nABC" android:textAllCaps="false" />
            <Button android:id="@+id/btn3" style="@style/NumPadButton" android:text="3\nDEF" android:textAllCaps="false" />

            <Button android:id="@+id/btn4" style="@style/NumPadButton" android:text="4\nGHI" android:textAllCaps="false" />
            <Button android:id="@+id/btn5" style="@style/NumPadButton" android:text="5\nJKL" android:textAllCaps="false" />
            <Button android:id="@+id/btn6" style="@style/NumPadButton" android:text="6\nMNO" android:textAllCaps="false" />

            <Button android:id="@+id/btn7" style="@style/NumPadButton" android:text="7\nPQRS" android:textAllCaps="false" />
            <Button android:id="@+id/btn8" style="@style/NumPadButton" android:text="8\nTUV" android:textAllCaps="false" />
            <Button android:id="@+id/btn9" style="@style/NumPadButton" android:text="9\nWXYZ" android:textAllCaps="false" />

            <!-- Row 4 -->
            <Button android:id="@+id/btn_del" style="@style/NumPadButton" android:text="DEL\n←" android:textColor="@color/accent_gold" android:textSize="14sp" android:textAllCaps="false" />
            <Button android:id="@+id/btn0" style="@style/NumPadButton" android:text="0\n_" android:textAllCaps="false" />
            <Button android:id="@+id/btn_ok" style="@style/NumPadButton" android:text="OK\n✔" android:textColor="#00E676" android:textSize="14sp" android:textAllCaps="false" />
        </GridLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/no_results"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No channels found"
        android:textColor="#80FFFFFF"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/search_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
