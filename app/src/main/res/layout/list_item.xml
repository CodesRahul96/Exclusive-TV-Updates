<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:layout_marginHorizontal="4dp"
    android:background="@drawable/selector_item_focus"
    android:paddingStart="@dimen/list_item_padding_horizontal"
    android:paddingEnd="@dimen/list_item_padding_horizontal"
    android:paddingTop="@dimen/list_item_padding_vertical"
    android:paddingBottom="@dimen/list_item_padding_vertical"
    android:focusable="true"
    android:clickable="true"
    android:stateListAnimator="@animator/tv_focus_animator">

    <TextView
        android:id="@+id/channel_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:background="@drawable/bg_channel_tag"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/list_item_num_text_size"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="110" />

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/list_item_icon_size"
        android:layout_height="@dimen/list_item_icon_size"
        app:layout_constraintStart_toEndOf="@id/channel_number"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_channel_icon"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:contentDescription="Channel Icon" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintEnd_toStartOf="@+id/heart"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/selector_text_menu"
        android:duplicateParentState="true"
        android:maxLines="1"
        tools:text="Channel Name"
        android:ellipsize="end"
        android:textSize="@dimen/list_item_text_size"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"/>

    <ImageView
        android:id="@+id/playing_indicator"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_playing_bars"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/heart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="8dp"
        app:tint="@color/accent_gold"
        tools:visibility="visible"
        android:contentDescription="Now Playing" />

    <ImageView
        android:id="@+id/heart"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_heart_empty"
        android:contentDescription="Favorite"
        app:layout_constraintEnd_toStartOf="@+id/arrows"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clickable="true"
        android:focusable="false"
        android:padding="4dp"
        app:tint="#4DFFFFFF"/>

    <LinearLayout
        android:id="@+id/arrows"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/arrow_up"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/arrow_up_float"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Move up"/>

        <ImageView
            android:id="@+id/arrow_down"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/arrow_down_float"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Move down"/>
    </LinearLayout>

    <TextView
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/heart"
        android:layout_marginStart="12dp"
        android:visibility="gone"
        android:text=""
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:alpha="0.8"/>
</androidx.constraintlayout.widget.ConstraintLayout>