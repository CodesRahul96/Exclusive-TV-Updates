<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="4dp"
    android:background="@drawable/selector_item_focus"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/channel_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="36dp"
        android:background="@drawable/bg_channel_tag"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="110" />

    <ImageView
        android:id="@+id/icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintStart_toEndOf="@id/channel_number"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_channel_icon"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:contentDescription="Channel Icon" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintEnd_toStartOf="@+id/heart"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/selector_text_menu"
        android:duplicateParentState="true"
        android:maxLines="1"
        tools:text="Channel Name"
        android:ellipsize="end"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"/>

    <ImageView
        android:id="@+id/heart"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_heart_empty"
        android:contentDescription="Favorite"
        app:layout_constraintEnd_toStartOf="@+id/arrows"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clickable="true"
        android:focusable="false"
        android:padding="4dp"
        app:tint="#4DFFFFFF"/>

    <LinearLayout
        android:id="@+id/arrows"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/arrow_up"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/arrow_up_float"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Move up"/>

        <ImageView
            android:id="@+id/arrow_down"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/arrow_down_float"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Move down"/>
    </LinearLayout>

    <TextView
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/heart"
        android:layout_marginStart="16dp"
        android:visibility="gone"
        android:text=""
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:alpha="0.8"/>
</androidx.constraintlayout.widget.ConstraintLayout>