<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/selector_item_focus"
    android:paddingStart="@dimen/group_item_padding_horizontal"
    android:paddingEnd="@dimen/group_item_padding_horizontal"
    android:paddingTop="@dimen/group_item_padding_vertical"
    android:paddingBottom="@dimen/group_item_padding_vertical"
    android:layout_marginBottom="6dp"
    android:layout_marginHorizontal="4dp"
    android:focusable="true"
    android:clickable="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:textColor="@color/selector_text_menu"
            android:duplicateParentState="true"
            android:textSize="@dimen/group_item_text_size"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"/>

        <LinearLayout
            android:id="@+id/arrows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/arrow_up"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/arrow_up_float"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Move up"/>

            <ImageView
                android:id="@+id/arrow_down"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/arrow_down_float"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Move down"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>