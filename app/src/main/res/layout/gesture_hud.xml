<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gesture_hud_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- Brightness HUD (Left) -->
    <LinearLayout
        android:id="@+id/hud_brightness"
        android:layout_width="wrap_content"
        android:layout_height="220dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="40dp"
        android:background="@drawable/bg_gesture_hud"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/brightness_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="8dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/gesture_progress_bar" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:src="@android:drawable/ic_menu_compass"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/brightness_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="50%" />
    </LinearLayout>

    <!-- Volume HUD (Right) -->
    <LinearLayout
        android:id="@+id/hud_volume"
        android:layout_width="wrap_content"
        android:layout_height="220dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_gesture_hud"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/volume_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="8dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/gesture_progress_bar" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/volume_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="50%" />
    </LinearLayout>

    <!-- Seek/Scrub HUD (Center) -->
    <LinearLayout
        android:id="@+id/hud_seek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_gesture_hud"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="20dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/seek_delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_gold"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="+00:10" />

        <TextView
            android:id="@+id/seek_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:text="00:45 / 10:00" />
            
        <ProgressBar
            android:id="@+id/seek_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:max="1000"
            android:progress="45"
            android:progressDrawable="@drawable/gesture_progress_bar" />
    </LinearLayout>

    <!-- Speed HUD (Top Center) -->
    <TextView
        android:id="@+id/hud_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_gesture_hud"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/accent_gold"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="2X Speed"
        android:visibility="gone" />

</FrameLayout>
