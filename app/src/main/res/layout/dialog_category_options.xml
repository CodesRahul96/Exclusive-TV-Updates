<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_background">

    <LinearLayout
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_premium_glass"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal"
        android:elevation="12dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_category"
        app:tint="@color/accent_gold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/tv_button_bg"
        android:padding="12dp"
        tools:ignore="UseAppTint" />

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Category Options"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_move"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_dialog_btn"
        android:text="Move Category"
        android:textAllCaps="false"
        android:focusable="true"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:drawableStart="@drawable/ic_playlist"
        android:drawablePadding="12dp"
        app:drawableTint="#80FFFFFF"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_rename"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_dialog_btn"
        android:text="Rename Category"
        android:textAllCaps="false"
        android:focusable="true"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:drawableStart="@drawable/ic_info_outline"
        android:drawablePadding="12dp"
        app:drawableTint="#80FFFFFF"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_hide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_dialog_btn"
        android:text="Hide Category"
        android:textAllCaps="false"
        android:focusable="true"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:drawableStart="@drawable/ic_trash"
        android:drawablePadding="12dp"
        app:drawableTint="#80FFFFFF"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="120dp"
        android:layout_height="1dp"
        android:background="#26FFFFFF"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_dialog_btn"
        android:backgroundTint="#33FFFFFF"
        android:text="Cancel"
        android:textAllCaps="false"
        android:focusable="true"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:alpha="0.8" />

    </LinearLayout>

</FrameLayout>