<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_menu_glass"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_category"
        android:tint="#FFD700"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Category Options"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btn_move"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_item_focus"
        android:text="Move Category"
        android:textAllCaps="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:drawableStart="@drawable/ic_playlist"
        android:drawablePadding="12dp"
        android:drawableTint="#80FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_rename"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_item_focus"
        android:text="Rename Category"
        android:textAllCaps="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:drawableStart="@drawable/ic_info_outline"
        android:drawablePadding="12dp"
        android:drawableTint="#80FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_hide"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_item_focus"
        android:text="Hide Category"
        android:textAllCaps="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:drawableStart="@drawable/ic_trash"
        android:drawablePadding="12dp"
        android:drawableTint="#80FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_cancel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_item_focus"
        android:text="Cancel"
        android:textAllCaps="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:alpha="0.8"
        android:padding="12dp" />

    </LinearLayout>

</FrameLayout>