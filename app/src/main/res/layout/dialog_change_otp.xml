<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_transparent_glass">

    <TextView
        style="@style/SettingsTitle"
        android:text="Change Login PIN / OTP"
        android:layout_marginBottom="16dp" 
        android:gravity="center"
        android:layout_width="match_parent"/>

    <EditText
        android:id="@+id/et_current_otp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Current OTP (e.g. 123321)"
        android:textColorHint="#66FFFFFF"
        android:textColor="@color/text_primary"
        android:background="@drawable/tv_input_bg"
        android:paddingHorizontal="18dp"
        android:textSize="14sp"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:layout_marginBottom="12dp"
        android:nextFocusDown="@+id/et_new_otp"/>

    <EditText
        android:id="@+id/et_new_otp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="New OTP (6 digits)"
        android:textColorHint="#66FFFFFF"
        android:textColor="@color/text_primary"
        android:background="@drawable/tv_input_bg"
        android:paddingHorizontal="18dp"
        android:textSize="14sp"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:layout_marginBottom="12dp"
        android:nextFocusUp="@+id/et_current_otp"
        android:nextFocusDown="@+id/et_confirm_otp"/>

    <EditText
        android:id="@+id/et_confirm_otp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Confirm New OTP"
        android:textColorHint="#66FFFFFF"
        android:textColor="@color/text_primary"
        android:background="@drawable/tv_input_bg"
        android:paddingHorizontal="18dp"
        android:textSize="14sp"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:layout_marginBottom="24dp"
        android:nextFocusUp="@+id/et_new_otp"
        android:nextFocusDown="@+id/btn_change_otp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_otp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_primary"
            android:background="@drawable/tv_button_bg"
            android:layout_marginEnd="8dp"
            android:nextFocusUp="@+id/et_confirm_otp"
            android:nextFocusRight="@+id/btn_change_otp"/>

        <Button
            android:id="@+id/btn_change_otp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Update"
            android:textColor="@color/text_primary"
            android:background="@drawable/tv_button_bg"
            android:enabled="false"
            android:alpha="0.5"
            android:nextFocusUp="@+id/et_confirm_otp"
            android:nextFocusLeft="@+id/btn_cancel_otp"/>
    </LinearLayout>
</LinearLayout>
