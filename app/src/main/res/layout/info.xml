<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom|center_horizontal"
    android:paddingBottom="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/info_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:background="@drawable/bg_info_card"
        android:elevation="12dp"
        android:padding="16dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_channel_icon"
            android:padding="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/date_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:drawableStart="@drawable/ic_time"
            android:drawablePadding="6dp"
            android:drawableTint="#B3FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Jan 17, 01:14 PM" />

        <TextView
            android:id="@+id/channel_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_channel_number"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintStart_toEndOf="@+id/logo"
            app:layout_constraintTop_toTopOf="@+id/title"
            tools:text="001" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintBottom_toTopOf="@+id/program_title"
            app:layout_constraintEnd_toStartOf="@+id/date_time"
            app:layout_constraintStart_toEndOf="@+id/channel_number"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/program_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/quality_container"
            app:layout_constraintStart_toStartOf="@+id/channel_number"
            app:layout_constraintTop_toBottomOf="@+id/title"
            tools:text="Current Program"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/program_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="#00B0FF"
            android:textSize="14sp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/quality_container"
            app:layout_constraintStart_toStartOf="@+id/channel_number"
            app:layout_constraintTop_toBottomOf="@+id/program_title"
            tools:text="08:00 PM - 09:00 PM"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="sans-serif"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/quality_container"
            app:layout_constraintStart_toStartOf="@+id/channel_number"
            app:layout_constraintTop_toBottomOf="@+id/program_time" />

        <TextView
            android:id="@+id/next_program_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="NEXT:"
            android:textColor="#FFAC33"
            android:textSize="12sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_update"
            android:drawablePadding="4dp"
            android:drawableTint="#FFAC33"
            android:gravity="center_vertical"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/channel_number"
            app:layout_constraintTop_toBottomOf="@+id/desc"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/next_program_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/next_program_label"
            app:layout_constraintEnd_toStartOf="@+id/next_program_time"
            app:layout_constraintStart_toEndOf="@+id/next_program_label"
            app:layout_constraintTop_toTopOf="@+id/next_program_label"
            tools:text="Upcoming Program Name"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/next_program_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans-serif"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/next_program_label"
            app:layout_constraintEnd_toStartOf="@+id/quality_container"
            app:layout_constraintTop_toTopOf="@+id/next_program_label"
            tools:text="09:00 PM"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/quality_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/video_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="1080p"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_video_quality"
                android:drawablePadding="4dp"
                android:drawableTint="#FFFFFF"
                android:gravity="center_vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/audio_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="5.1"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_audio_track"
                android:drawablePadding="4dp"
                android:drawableTint="#FFFFFF"
                android:gravity="center_vertical"
                android:visibility="gone" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>