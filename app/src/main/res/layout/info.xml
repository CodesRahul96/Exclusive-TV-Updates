<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom|center_horizontal"
    android:paddingBottom="32dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/info_card"
        style="@style/ExclusiveCard.Glass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="64dp"
        android:padding="20dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_channel_icon"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/date_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:drawableStart="@drawable/ic_time"
            android:drawablePadding="8dp"
            app:drawableTint="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Jan 17, 01:14 PM" />

        <TextView
            android:id="@+id/channel_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_channel_number"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintStart_toEndOf="@+id/logo"
            app:layout_constraintTop_toTopOf="@+id/title"
            tools:text="001" />

        <TextView
            android:id="@+id/title"
            style="@style/ExclusiveText.Header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            app:layout_constraintBottom_toTopOf="@+id/program_title"
            app:layout_constraintEnd_toStartOf="@+id/date_time"
            app:layout_constraintStart_toEndOf="@+id/channel_number"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/program_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/accent_gold"
            android:textSize="19sp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/quality_container"
            app:layout_constraintStart_toStartOf="@+id/channel_number"
            app:layout_constraintTop_toBottomOf="@+id/title"
            tools:text="Current Program"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/program_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="#00B0FF"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/quality_container"
            app:layout_constraintStart_toStartOf="@+id/channel_number"
            app:layout_constraintTop_toBottomOf="@+id/program_title"
            tools:text="03:00 PM - 04:00 PM"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/program_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:progressDrawable="@drawable/custom_progress_bg"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/quality_container"
            app:layout_constraintStart_toStartOf="@+id/channel_number"
            app:layout_constraintTop_toBottomOf="@+id/program_time"
            tools:progress="40"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/desc"
            style="@style/ExclusiveText.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            app:layout_constraintEnd_toStartOf="@+id/quality_container"
            app:layout_constraintStart_toStartOf="@+id/channel_number"
            app:layout_constraintTop_toBottomOf="@+id/program_progress" />

        <TextView
            android:id="@+id/next_program_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="NEXT:"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_update"
            android:drawablePadding="6dp"
            app:drawableTint="@color/accent_gold"
            android:gravity="center_vertical"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/channel_number"
            app:layout_constraintTop_toBottomOf="@+id/desc"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/next_program_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/next_program_label"
            app:layout_constraintEnd_toStartOf="@+id/next_program_time"
            app:layout_constraintStart_toEndOf="@+id/next_program_label"
            app:layout_constraintTop_toTopOf="@+id/next_program_label"
            tools:text="Upcoming Program Name"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/next_program_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans-serif"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/next_program_label"
            app:layout_constraintEnd_toStartOf="@+id/quality_container"
            app:layout_constraintTop_toTopOf="@+id/next_program_label"
            tools:text="09:00 PM"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/quality_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/video_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="1080p"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_video_quality"
                android:drawablePadding="6dp"
                app:drawableTint="@color/white"
                android:gravity="center_vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/audio_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="5.1"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_audio_track"
                android:drawablePadding="6dp"
                app:drawableTint="@color/white"
                android:gravity="center_vertical"
                android:visibility="gone" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>