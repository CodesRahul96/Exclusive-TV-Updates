<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:descendantFocusability="afterDescendants">


        <ImageView
            android:id="@+id/maintenanceIcon"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/logo_exclusive"
            android:elevation="20dp"
            android:contentDescription="ExclusiveTV Logo" />

        <TextView
            android:id="@+id/maintenanceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-black"
            android:text="System Maintenance"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:gravity="center" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/maintenanceMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/bg_transparent_glass"
                android:fontFamily="sans-serif-medium"
                android:text="ExclusiveTV is currently under scheduled maintenance to enhance your viewing experience. We will be back shortly with more premium content."
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="3"
                android:ellipsize="end"
                android:maxWidth="700dp" />
        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="100dp"
            android:layout_height="2dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_gold_gradient"
            android:layout_gravity="center_horizontal" />


        <!-- Exit App Button (moved above version for focus reliability) -->
        <Button
            android:id="@+id/btnExit"
            android:layout_width="140dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:text="Exit App"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_transparent_glass"
            android:elevation="3dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:layout_gravity="center_horizontal"
            android:nextFocusDown="@+id/appVersion"
            android:nextFocusUp="@+id/maintenanceMessage"
            android:nextFocusLeft="@+id/btnExit"
            android:nextFocusRight="@+id/btnExit" />

        <TextView
            android:id="@+id/appVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="Exclusive TV Premium Experience"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:gravity="center" />

    </LinearLayout>
</FrameLayout>
