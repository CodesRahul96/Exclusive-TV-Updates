<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="64dp">

        <ImageView
            android:id="@+id/maintenanceIcon"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/logo_exclusive"
            android:elevation="16dp"
            android:contentDescription="ExclusiveTV Logo" />

        <TextView
            android:id="@+id/maintenanceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-black"
            android:text="System Maintenance"
            android:textColor="@color/white"
            android:textSize="38sp"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/maintenanceMessage"
                android:layout_width="550dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:background="@drawable/bg_transparent_glass"
                android:fontFamily="sans-serif-medium"
                android:text="ExclusiveTV is currently under scheduled maintenance to enhance your viewing experience. We will be back shortly with more premium content."
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:lineSpacingMultiplier="1.3" />
        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="180dp"
            android:layout_height="2dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_gold_gradient" />

        <TextView
            android:id="@+id/appVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-medium"
            android:text="Exclusive TV Premium Experience"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:letterSpacing="0.1" />

    </LinearLayout>
</FrameLayout>
