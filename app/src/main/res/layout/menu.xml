<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/menu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Dimmed Full-Screen Overlay (Rest of screen) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- Localized Background for Lists Area -->
    <View
        android:id="@+id/menu_panel_bg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:background="@drawable/bg_main_gradient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/list" />

    <!-- The 50% Guide (Left Half) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.50" />

    <!-- Grid Guide Button -->
    <LinearLayout
        android:id="@+id/btn_grid_guide"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:visibility="gone"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_dialog_btn"
        android:focusable="true"
        android:clickable="true"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:elevation="12dp"
        android:layout_marginStart="24dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="TV Guide"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <!-- Categories Sidebar -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/group"
        style="@style/ExclusiveCard.Glass"
        android:layout_width="220dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_grid_guide"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp">
    </androidx.recyclerview.widget.RecyclerView>

    <!-- Clock -->
    <TextClock
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="hh:mm a"
        android:format24Hour="HH:mm"
        android:textColor="@color/accent_gold"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="10dp" />

    <!-- Channels Panel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        style="@style/ExclusiveCard.Glass"
        android:layout_width="450dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/group"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp">
    </androidx.recyclerview.widget.RecyclerView>

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No channels in this category"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/list"
        app:layout_constraintEnd_toEndOf="@id/list"
        app:layout_constraintTop_toTopOf="@id/list"
        app:layout_constraintBottom_toBottomOf="@id/list"
        android:elevation="10dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
