<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: scales up to 105% and raises elevation to 8dp for the pop effect -->
    <item android:state_focused="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="1.05"
                android:duration="150"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="1.05"
                android:duration="150"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationZ"
                android:valueTo="8dp"
                android:duration="150"
                android:valueType="floatType" />
        </set>
    </item>

    <!-- Default non-focused state: reset scale to 100% and elevation to 0 -->
    <item android:state_focused="false">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:duration="150"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:duration="150"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationZ"
                android:valueTo="0dp"
                android:duration="150"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
