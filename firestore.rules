rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permanent fix for ExclusiveTV-APP
    // These rules match the app's structure where 'users' collection 
    // uses phone numbers as document IDs and handles sync/subscription.
    
    match /users/{userId} {
      allow read, write: if true; 
    }

    match /trials/{deviceId} {
      // Allows checking it during registration to prevent duplicate trials
      allow read, write: if true;
    }

    match /master_bypass/{phoneNumber} {
      // Allows checking if a specific phone number is authorized to skip device checks
      allow read: if true;
    }

    match /registrations_by_ip/{ip} {
      // Only the Cloud Function (admin) should manage this
      allow read, write: if false; 
    }
    
    // Protect everything else (default deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
